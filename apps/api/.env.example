PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql://user:password@localhost:5432/arabic_platform

# Frontend base URL — used for Stripe success/cancel redirect URLs
FRONTEND_URL=http://localhost:3000

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate a long random secret for hosted environments; invite teachers privately.
TEACHER_INVITE_CODE=

# LiveKit server-side credentials (never NEXT_PUBLIC_)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe: use test keys in preview and a separate webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Password reset mail delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
