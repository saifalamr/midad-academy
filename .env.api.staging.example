# Separate staging database and TEST provider credentials only.
# Configure these in Railway Variables; do not paste secrets into chat.
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=https://your-staging-web.vercel.app
JWT_SECRET=
DATABASE_URL=

# Frontend base URL — used for Stripe success/cancel redirect URLs
FRONTEND_URL=https://your-staging-web.vercel.app
API_URL=https://your-staging-api.up.railway.app

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Generate a long random secret for hosted environments; invite teachers privately.
TEACHER_INVITE_CODE=

# LiveKit server-side credentials (never NEXT_PUBLIC_)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stripe: use test keys in preview and a separate webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Password reset mail delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Railpack build/runtime settings
RAILPACK_NODE_VERSION=24
RAILPACK_NODE_NPM_INSTALL=npm ci
RAILPACK_PRUNE_DEPS=false
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
